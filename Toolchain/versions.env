# Pinned versions for the LemonSeed Studio toolchain. Sourced by the scripts
# in Toolchain/scripts. Changing a pin invalidates the matching build output.

# LLVM (clang, lld, clangd). Matches the LLVM 21.1.8 used by the engine.
LLVM_VERSION=21.1.8
LLVM_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/llvm-project-${LLVM_VERSION}.src.tar.xz"
LLVM_SHA256=4633a23617fa31a3ea51242586ea7fb1da7140e426bd62fc164261fe036aa142

# wasi-sdk 30 is the last release built on LLVM 21 (31 moved to LLVM 22).
WASI_SDK_VERSION=30
WASI_SDK_FULL_VERSION=30.0
WASI_SYSROOT_URL="https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sysroot-${WASI_SDK_FULL_VERSION}.tar.gz"
WASI_SYSROOT_SHA256=0c8f3e0acab6d3061834395a16550c359766909fda046af3d9b8cf3bfdb1c2cc
WASI_RT_URL="https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/libclang_rt-${WASI_SDK_FULL_VERSION}.tar.gz"
WASI_RT_SHA256=1aaf34d5f30227206d9d6dd3aa0d8af4019a201a1d73fc64a44fe0a6058c54c3

# wasix-libc: the WASIX sysroot (--target=wasm32-wasix), its libc++ and its
# atomics-enabled compiler-rt builtins. Programs built for it run on WAMR
# with the wasix_32v1 calls implemented in Packages/StudioToolchain (lst_wasix.c).
WASIX_LIBC_VERSION=v2026-10-02.1
WASIX_SYSROOT_URL="https://github.com/wasix-org/wasix-libc/releases/download/${WASIX_LIBC_VERSION}/sysroot.tar.gz"
WASIX_SYSROOT_SHA256=ffc1a6f52e81a4945a9df7bb2fee632a051403eb64316b006543ea54cd779c6b

# WebAssembly Micro Runtime (fast interpreter only).
WAMR_VERSION=2.4.5
WAMR_URL="https://github.com/bytecodealliance/wasm-micro-runtime/archive/refs/tags/WAMR-${WAMR_VERSION}.tar.gz"
WAMR_SHA256=1ab09d51099f276ca4a1d6629f6b589aab2bd0caa01445e05031a4bed22c199b

# Deployment target for every iOS slice.
IOS_DEPLOYMENT_TARGET=26.2
