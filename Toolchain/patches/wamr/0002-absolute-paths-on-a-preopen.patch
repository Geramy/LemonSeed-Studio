+/* LemonSeed Studio: the preopens of the program running exec_env
+ * (libc_wasi_wrapper.c). */
+struct fd_prestats *
+lst_wasi_prestats(wasm_exec_env_t exec_env);
+
+/* LemonSeed Studio: an absolute path on a preopened directory names a path
+ * under that directory. wasix-libc resolves every path against its working
+ * directory and passes it, absolute, with the preopen registered as "/"; the
+ * root of the program's file system is the preopen. wasi-libc never passes an
+ * absolute path, so WASI programs see no change. */
+static void
+lst_strip_root(wasm_exec_env_t exec_env, __wasi_fd_t fd, char *path)
+{
+    if (path[0] != '/')
+        return;
+    struct fd_prestats *pt = lst_wasi_prestats(exec_env);
+    if (pt == NULL)
+        return;
+    struct fd_prestat *prestat;
+    rwlock_rdlock(&pt->lock);
+    bool preopen = fd_prestats_get_entry(pt, fd, &prestat) == 0;
+    rwlock_unlock(&pt->lock);
+    if (!preopen)
+        return;
+    size_t skip = strspn(path, "/");
+    memmove(path, path + skip, strlen(path + skip) + 1);
+    if (path[0] == '\0')
+        strcpy(path, "."); /* the buffer holds at least the stripped "/" */
+}
