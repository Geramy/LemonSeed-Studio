Treat iOS like Darwin when choosing linker flags.

LLVM matches CMAKE_SYSTEM_NAME against "Darwin" to avoid ELF-only linker
flags (-z defs, --gc-sections). A CMAKE_SYSTEM_NAME=iOS cross build then
passes those flags to ld64, which rejects them when linking any dylib or
executable. Use -dead_strip and skip -z defs for the Apple embedded systems too.

diff -ru a/llvm/cmake/modules/AddLLVM.cmake b/llvm/cmake/modules/AddLLVM.cmake
--- a/llvm/cmake/modules/AddLLVM.cmake	2026-10-02 21:41:18
+++ b/llvm/cmake/modules/AddLLVM.cmake	2026-10-02 21:41:18
@@ -315,7 +315,7 @@
   # linker in a context where the optimizations are not important.
   if (NOT uppercase_CMAKE_BUILD_TYPE STREQUAL "DEBUG")
     if(NOT LLVM_NO_DEAD_STRIP)
-      if(${CMAKE_SYSTEM_NAME} MATCHES "Darwin")
+      if(${CMAKE_SYSTEM_NAME} MATCHES "Darwin|iOS|tvOS|watchOS|visionOS")
         # ld64's implementation of -dead_strip breaks tools that use plugins.
         set_property(TARGET ${target_name} APPEND_STRING PROPERTY
                      LINK_FLAGS " -Wl,-dead_strip")
diff -ru a/llvm/cmake/modules/HandleLLVMOptions.cmake b/llvm/cmake/modules/HandleLLVMOptions.cmake
--- a/llvm/cmake/modules/HandleLLVMOptions.cmake	2026-10-02 21:41:18
+++ b/llvm/cmake/modules/HandleLLVMOptions.cmake	2026-10-02 21:41:18
@@ -322,7 +322,7 @@
 
 # Pass -Wl,-z,defs. This makes sure all symbols are defined. Otherwise a DSO
 # build might work on ELF but fail on MachO/COFF.
-if(NOT (CMAKE_SYSTEM_NAME MATCHES "Darwin|FreeBSD|OpenBSD|DragonFly|AIX|OS390|Emscripten" OR
+if(NOT (CMAKE_SYSTEM_NAME MATCHES "Darwin|iOS|tvOS|watchOS|visionOS|FreeBSD|OpenBSD|DragonFly|AIX|OS390|Emscripten" OR
         WIN32 OR CYGWIN) AND
    NOT LLVM_USE_SANITIZER)
   set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-z,defs")
